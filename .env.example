# Database. Locally a SQLite file is used automatically (file:local.db).
# In production, create a free Turso database (turso.tech) and paste its URL and token.
DATABASE_URL=libsql://your-db-name-your-org.turso.io
DATABASE_AUTH_TOKEN=

# Long random string used to sign login cookies. Generate with: openssl rand -base64 32
SESSION_SECRET=

# Optional: founder logins created by `npm run db:seed` (otherwise random passwords are printed)
ADMIN_1_NAME=
ADMIN_1_EMAIL=
ADMIN_1_PASSWORD=
ADMIN_2_NAME=
ADMIN_2_EMAIL=
ADMIN_2_PASSWORD=

# Optional: public website address used in WhatsApp messages (can also be set in Admin → Settings)
SITE_URL=https://aaobaithein.pk
